# Copy to .env and KEEP SECRET. Use a NEW, testnet-only deployer wallet.
PRIVATE_KEY=
BASE_RPC_URL=https://sepolia.base.org
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
